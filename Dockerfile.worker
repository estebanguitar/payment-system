FROM eclipse-temurin:17.0.13_11-jdk-jammy AS builder
WORKDIR /workspace
COPY gradlew settings.gradle build.gradle ./
COPY gradle ./gradle
COPY src ./src
COPY outbox-worker ./outbox-worker
RUN chmod +x gradlew && ./gradlew --no-daemon :outbox-worker:bootJar

FROM eclipse-temurin:17.0.13_11-jre-jammy
WORKDIR /app
RUN useradd --system --uid 10002 worker && mkdir /data && chown worker:worker /data
COPY --from=builder --chown=worker:worker /workspace/outbox-worker/build/libs/outbox-worker-0.0.1-SNAPSHOT.jar app.jar
USER worker
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
